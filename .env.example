# ─── Server-side secrets (never use REACT_APP_ prefix for secrets) ───────────

# Gemini / Google Generative Language API key
# Generate a new key at https://aistudio.google.com/app/apikey
# The old key starting with AIzaSyCj...ZWyk is COMPROMISED — do not reuse it.
GEMINI_API_KEY=your_gemini_api_key_here

# Resend email API key
RESEND_API_KEY=your_resend_api_key_here

# From address used by Resend
RESEND_FROM_EMAIL=Dallas Chatbot <noreply@dallastrading.net>

# Office routing emails
DALLAS_DUBAI_EMAIL=info@dallastrading.net
DALLAS_OMAN_EMAIL=vijay@dallastrading.net
DALLAS_SAUDI_EMAIL=jay@pesgulf.com

# ─── Frontend (baked into the React bundle — do NOT put secrets here) ─────────

# URL of the backend API server as seen by the browser
# Production: https://www.dallastrading.net  (or wherever your Express server is proxied)
# Development: http://localhost:3001
REACT_APP_API_URL=http://localhost:3001
